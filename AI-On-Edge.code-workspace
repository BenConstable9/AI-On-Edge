{
  "folders": [
    { "name": "vLLM Server (device)", "path": "modules/vllm" },
    { "name": "Camera Processor (device)", "path": "modules/camera_processor" },
    { "name": "Viewer (laptop)", "path": "modules/viewer" },
    { "name": "Deployment", "path": "deployment" },
    { "name": "Infrastructure", "path": "infra" },
    { "name": "Automation Scripts", "path": "scripts" }
  ],
  "settings": {
    "files.trimTrailingWhitespace": true,
    "editor.formatOnSave": true,
    "python.testing.pytestEnabled": true,
    "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.egg-info": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "charliermarsh.ruff",
      "ms-azuretools.vscode-docker",
      "ms-azuretools.vscode-bicep",
      "ms-azuretools.vscode-azureiotedge",
      "ms-vscode.powershell",
      "bierner.markdown-mermaid"
    ]
  }
}
